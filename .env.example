# Copy this file to .env and adjust for how you're running the app.
# EXPO_PUBLIC_* values are inlined into the app bundle at build time —
# see src/config/api.ts. This URL is not secret (it's just an
# address), but it IS machine/network-specific, which is why .env
# itself isn't committed (see .gitignore) while this .example file is.

# Android emulator (default if EXPO_PUBLIC_BACKEND_URL is unset):
# 10.0.2.2 is the emulator's alias for your host machine's localhost.
EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2:8000

# iOS Simulator instead talks to your host machine as "localhost":
# EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# A physical phone (Android or iOS) instead needs your computer's LAN
# IP address, with phone and computer on the same Wi-Fi — see
# backend/README.md for how to find it and for firewall notes:
# EXPO_PUBLIC_BACKEND_URL=http://192.168.1.50:8000
